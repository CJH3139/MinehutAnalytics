{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minehut-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minehut-analytics",
      "database_id": "7e98cdb8-a51c-442c-b394-af8f01d62731",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
